# Copia questo file in .streamlit/secrets.toml e valorizza le chiavi.
# .streamlit/secrets.toml e' in .gitignore: non va mai committato.
#
# Su Streamlit Community Cloud queste stesse chiavi vanno incollate nel
# pannello "Secrets" dell'app (Settings > Secrets), con la stessa sintassi TOML.

# Stringa di connessione Postgres (Supabase: Project Settings > Database >
# Connection string > URI). Se omessa, l'app usa SQLite locale (data/crossfit.db).
DATABASE_URL = "postgresql://postgres:[password]@[host]:[port]/postgres"

# Chiave API Anthropic, usata da core/llm_parser.py per l'estrazione del
# programma dal file .docx.
ANTHROPIC_API_KEY = "sk-ant-..."
